---
// Portada «Foco» (DESIGN.md §5): todo lo importante en la primera pantalla.
// El foco que sigue al ratón y el diagrama los anima public/assets/foco.js.
import { existsSync } from "node:fs";
import { IAS } from "../data/confianza";
import { DIAGNOSTICO, TEXTOS } from "../data/site";
import { CONTRATA, CTA_CONTRATA, CTA_HABLAR, CTA_RESERVA } from "../data/contrata";

const NODOS = [
  { k: "01", name: "Tus tareas", text: "Emails, presupuestos, facturas, atención al cliente: todo lo que hoy hacéis a mano y os come horas." },
  { k: "02", name: "Caso de uso", text: "Elegimos la tarea que más tiempo os quita y calculamos cuánto vais a ahorrar antes de tocar nada." },
  { k: "03", name: "IA", text: "Claude, ChatGPT, Gemini o Copilot: la que mejor encaje con lo que ya usáis. Sin desarrollos a medida caros." },
  { k: "04", name: "Tu equipo", text: "Deja lo repetitivo y dedica ese tiempo a vender y a atender. Con formación y sin depender de nadie." }
];
const COMO = [
  { n: "2–3 sem", dot: true, b: "Primer caso de uso", t: "Funcionando, no en un PowerPoint", href: "#metodo", go: "Cómo" },
  { n: `${DIAGNOSTICO.precio} €`, dot: false, b: "Precio cerrado", t: TEXTOS.focoDetalle, href: CONTRATA.activo ? "#diagnostico" : "#servicios", go: "Precios" },
  { n: "0 €", dot: false, b: "En comisiones", t: "No revendemos licencias", href: "#por-que", go: "Por qué" }
];
// Logo oficial si existe en public/img/logos/ia/; si no, el nombre en texto.
const logoDe = (slug: string) => ["svg", "png"].map((ext) => `/img/logos/ia/${slug}.${ext}`)
  .find((f) => existsSync(new URL(`../../public${f}`, import.meta.url))) ?? null;
const ias = IAS.map((i) => ({ ...i, logo: logoDe(i.slug) }));
---
<section class="foco" id="foco" aria-labelledby="foco-title">
  <div class="foco-spot" aria-hidden="true"></div>
  <div class="wrap">
    <div class="foco-copy">
      <p class="kicker">IA para pymes · precio cerrado, sin sorpresas</p>
      <h1 id="foco-title">Implanta IA en tu empresa <span class="hl">sin pagar pastizales<svg viewBox="0 0 300 20" preserveAspectRatio="none" aria-hidden="true"><path d="M3 14 C 60 4, 120 4, 180 10 S 270 16, 297 6"></path></svg></span>.</h1>
      <p class="foco-sub">Antes de empezar te decimos cuánto vas a ahorrar y cuánto te va a costar. Tu primer caso de uso, funcionando en 2–3 semanas con herramientas que ya existen.</p>
      <div class="foco-actions">
        {CONTRATA.activo ? (
          <a class="btn btn-primary" href={CTA_CONTRATA.href} data-contrata-cta data-texto-cerrado={CTA_RESERVA.texto} data-href-cerrado="#contacto">{CTA_CONTRATA.texto}</a>
        ) : (
          <a class="btn btn-primary" href="/calculadora/">Calcula tu ahorro</a>
        )}
        {CONTRATA.activo ? (
          <a class="btn btn-ghost" href="/calculadora/">Calcula tu ahorro</a>
        ) : (
          <a class="btn btn-ghost" href="#contacto" data-interest="Diagnóstico IA exprés">{CTA_RESERVA.texto}</a>
        )}
      </div>
      {CONTRATA.activo && <p class="foco-hablar"><a href="#contacto" data-interest="Diagnóstico IA exprés">{CTA_HABLAR.texto}</a></p>}
    </div>

    <div class="flow" aria-label="Cómo encaja todo: del dato al agente">
      <ul class="flow-nodes">
        {NODOS.map((n, i) => (
          <li class={i === 1 ? "on" : undefined}>
            <button type="button" class="flow-node" aria-expanded={i === 1 ? "true" : "false"}>
              <span class="flow-k">{n.k}</span>
              <span class="flow-name">{n.name}</span>
              <span class="flow-text">{n.text}</span>
            </button>
          </li>
        ))}
      </ul>
      <div class="flow-wire" aria-hidden="true"></div>
    </div>

    <div class="how-grid">
      {COMO.map((c) => (
        <a class="how" href={c.href}>
          <span class="how-n">{c.n}{c.dot && <span class="dot-accent">.</span>}</span>
          <span class="how-t"><b>{c.b}</b>{c.t}</span>
          <span class="how-go">{c.go} <span aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>

    <div class="trust trust-ia">
      <p class="trust-label">Trabajamos con</p>
      <ul class="ia-list">
        {ias.map((i) => (
          <li title={`${i.name} · ${i.by}`}>
            {i.logo ? <img src={i.logo} alt={`${i.name} (${i.by})`} loading="lazy" /> : <><span class="ia-name">{i.name}</span><span class="ia-by">{i.by}</span></>}
          </li>
        ))}
      </ul>
    </div>
    <slot />
  </div>
</section>
