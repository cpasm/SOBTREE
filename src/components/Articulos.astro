---
// Artículos en portada (DESIGN.md §9): uno destacado con portada y resumen, y una lista con miniaturas.
import Cover from "./Cover.astro";
import { getAnalisis, getRadar, fmtShort } from "../data/content";

const [analisis, radar] = await Promise.all([getAnalisis(), getRadar()]);
const todos = [
  ...analisis.map((e) => ({ url: `/analisis/${e.id}/`, tag: e.data.linea, title: e.data.title, sum: e.data.description, date: e.data.date, img: e.data.imagen, alt: e.data.imagenAlt })),
  ...radar.map((e) => ({ url: `/radar/${e.id}/`, tag: "Radar", title: e.data.title, sum: e.data.description, date: e.data.date, img: e.data.imagen, alt: e.data.imagenAlt }))
].sort((a, b) => b.date.getTime() - a.date.getTime());
// El destacado es el último análisis (o lo último publicado si no hay análisis).
const destacado = todos.find((t) => t.tag !== "Radar") ?? todos[0];
const resto = todos.filter((t) => t !== destacado).slice(0, 3);
---
{destacado && (
  <section class="reads" id="articulos" aria-labelledby="reads-title">
    <div class="wrap">
      <div class="reads-head">
        <h2 id="reads-title">Para el CIO que quiere gastar menos y ganar más<span class="dot-accent">.</span></h2>
        <a href="/analisis/">Todos los artículos →</a>
      </div>
      <div class="reads-grid">
        <a class="feature" href={destacado.url}>
          <div class="cover"><Cover title={destacado.title} src={destacado.img} alt={destacado.alt} /></div>
          <span class="line-tag">{destacado.tag} · {fmtShort(destacado.date)}</span>
          <span class="feature-title">{destacado.title}</span>
          <span class="feature-sum">{destacado.sum}</span>
        </a>
        {resto.length > 0 && (
          <div class="reads-list">
            <p>Más para el CIO</p>
            {resto.map((r) => (
              <a class="item" href={r.url}>
                <span class="thumb"><Cover title={r.title} src={r.img} alt={r.alt} /></span>
                <span>
                  <span class="line-tag">{r.tag}</span>
                  <span class="item-title">{r.title}</span>
                  <span class="item-meta">{fmtShort(r.date)}</span>
                </span>
              </a>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>
)}
