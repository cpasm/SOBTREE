---
import { render } from "astro:content";
import Post from "../../layouts/Post.astro";
import { getAnalisis, temaDe } from "../../data/content";

export async function getStaticPaths() {
  const items = await getAnalisis();
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Post {...entry.data} tema={temaDe(entry.data.linea, entry.data.tags)} path={`/analisis/${entry.id}/`} back={{ href: "/analisis/", label: "Todos los análisis" }}>
  <Content />
</Post>
