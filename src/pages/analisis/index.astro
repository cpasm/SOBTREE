---
import Base from "../../layouts/Base.astro";
import Cover from "../../components/Cover.astro";
import { getAnalisis, fmtDate, temaDe } from "../../data/content";
import { graph, organization, website } from "../../data/schema";

const items = await getAnalisis();
---
<Base title="Artículos sobre IA para pymes | Sobtree" description="Guías prácticas para implantar IA en tu empresa: por dónde empezar, cuánto cuesta, cuánto ahorras y qué dice la ley." jsonld={graph(organization(), website())} noindex={items.length === 0}>
  <main id="main" class="section page-tight">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Análisis</p>
        <h1 class="page-title">Guías para implantar IA en tu pyme</h1>
      </div>
      {items.length === 0
        ? <p class="section-sub">Pronto publicaremos los primeros análisis.</p>
        : <ul class="post-grid">
            {items.map((e) => (
              <li>
                <a class="post-card" href={`/analisis/${e.id}/`}>
                  <span class="cover"><Cover title={e.data.title} src={e.data.imagen} alt={e.data.imagenAlt} tema={temaDe(e.data.linea, e.data.tags)} /></span>
                  <span class="post-card-body">
                    <span class="line-tag">{e.data.linea} · <time datetime={e.data.date.toISOString()}>{fmtDate(e.data.date)}</time></span>
                    <span class="post-card-title">{e.data.title}</span>
                    <span class="post-card-sum">{e.data.description}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>}
    </div>
  </main>
</Base>
