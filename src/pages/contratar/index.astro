---
import Base from "../../layouts/Base.astro";
import { CONTRATA, SERVICIOS, serviciosConImportes } from "../../data/contrata";
import { DIAGNOSTICO, POLITICA_VERSION, TEXTOS, PLAZO_DIAGNOSTICO } from "../../data/site";
import { euros, TEXTO_RESERVA } from "../../data/contrata-logica.mjs";

const activo = CONTRATA.activo;
const precio = CONTRATA.importes;
const varios = SERVICIOS.length > 1;
---
{activo ? (
<Base title="Contrata el diagnóstico | Sobtree" description="Diagnóstico IA exprés a precio cerrado, con IVA, para empresas y autónomos.">
<main id="main" class="section contrata-page">
  <div class="wrap contrata-wrap">
    <div class="contrata-heading">
      <p class="eyebrow">Diagnóstico IA exprés</p>
      <h1>Contrata tu diagnóstico</h1>
      <p class="section-sub">Primero elige la semana de inicio. Después completarás los datos de contacto y facturación.</p>
    </div>
    <section class="contrata-resumen" aria-label="Resumen del servicio">
      <div class="contrata-resumen-precio">
        <p class="contrata-label">Precio total, IVA incluido</p>
        <p class="contrata-total" id="contrata-total-visible">{euros(precio.totalCentimos)}</p>
        <p class="fine">Base {euros(precio.baseCentimos)} · IVA {euros(precio.ivaCentimos)}</p>
      </div>
      <div class="contrata-resumen-detalle">
        <p><strong>Qué incluye</strong><br />Informe con 3 casos de uso priorizados, ahorro estimado, costes y plan de implantación.</p>
        <p class="fine">{TEXTOS.lineaCorta} {TEXTOS.condiciones}</p>
        <p class="fine">Confirmamos la fecha por email en 1 día laborable. Si no fuera posible, te ofrecemos otra semana o el reembolso íntegro. Entrega del informe: {PLAZO_DIAGNOSTICO}. La plaza se retiene 30 minutos mientras completas el pago.</p>
      </div>
    </section>
    <div class="contrata-precio" id="contrata-precio" data-base={DIAGNOSTICO.precio} data-total={precio.totalCentimos} data-iva={CONTRATA.ivaPorciento} hidden>
      <p>Base <strong>{euros(precio.baseCentimos)}</strong></p>
      <p>IVA {CONTRATA.ivaPorciento} % <strong>{euros(precio.ivaCentimos)}</strong></p>
      <p class="contrata-total">Total {euros(precio.totalCentimos)}</p>
    </div>
    <div id="contrata-estado" role="status" class="form-status contrata-status" aria-live="polite">Consultando las semanas disponibles…</div>
    <noscript>
      <p>Para ver las semanas hace falta JavaScript. Si no puedes usarlo, <a href="/#contacto">{TEXTO_RESERVA}</a>.</p>
    </noscript>

    <form class="contact" id="contrata-form" hidden>
      {varios ? (
        <fieldset class="semanas" id="contrata-servicios">
          <legend>Elige el servicio</legend>
          {serviciosConImportes.map((sv, i) => (
            <label class="semana">
              <input type="radio" name="servicio" value={sv.id} checked={i === 0} required data-total={sv.importes.totalCentimos} data-base={sv.importes.baseCentimos} />
              <span>{sv.nombre} · {euros(sv.importes.totalCentimos)} con IVA</span>
            </label>
          ))}
        </fieldset>
      ) : (
        <p class="contrata-servicio" id="contrata-servicio" data-servicio={serviciosConImportes[0].id}>Servicio: <strong>{serviciosConImportes[0].nombre}</strong> · {euros(serviciosConImportes[0].importes.totalCentimos)} con IVA</p>
      )}
      <div id="contrata-paso-semana">
      <fieldset class="semanas" id="contrata-semanas">
        <legend>1. Elige la semana de inicio</legend>
      </fieldset>
      <p class="fine contrata-ayuda-semana">La fecha es la semana prevista de inicio, de lunes a viernes. Te confirmaremos el día exacto por email.</p>
      <button class="btn btn-primary" type="button" id="contrata-continuar">Continuar a los datos de contacto</button>
      </div>
      <section id="contrata-paso-contacto" hidden aria-label="Datos de contacto y facturación">
      <h2 class="contrata-paso-titulo">2. Datos de contacto y facturación</h2>
      <div class="row-2">
        <label>Empresa<input name="empresa" id="contrata-empresa" autocomplete="organization" maxlength="200" required></label>
        <label>Email de la empresa<input name="email" id="contrata-email" type="email" autocomplete="email" maxlength="254" required></label>
      </div>
      <label>NIF o CIF
        <input name="nif" id="contrata-nif" autocomplete="off" maxlength="20" required inputmode="text" spellcheck="false" aria-describedby="ayuda-nif">
      </label>
      <p id="ayuda-nif" class="fine" style="text-align:left">Solo empresas y autónomos con NIF o CIF español. Comprobamos el formato y lo usamos para tu factura, que recibirás por email tras el pago. Stripe te pedirá la dirección de facturación.</p>
      <label class="hp" aria-hidden="true">No rellenar<input name="web" tabindex="-1" autocomplete="off"></label>
      <label class="consent"><input type="checkbox" name="condiciones" id="contrata-condiciones" value="si" required><span>Acepto las <a href="/condiciones/">condiciones de contratación</a> y la <a href="/privacidad/">política de privacidad</a> (versión {POLITICA_VERSION}). El pago lo procesa Stripe en su página.</span></label>
      <div class="contrata-acciones">
        <button class="btn btn-ghost" type="button" id="contrata-volver">Volver a elegir semana</button>
        <button class="btn btn-primary" type="submit" id="contrata-pagar">Pagar {euros(precio.totalCentimos)}</button>
      </div>
      <p class="fine" style="text-align:left"><a href="/#contacto">Prefiero que me confirméis la fecha</a></p>
      </section>
    </form>
  </div>
</main>
<script is:inline define:vars={{ endpointDisp: CONTRATA.endpoints.disponibilidad, endpointPago: CONTRATA.endpoints.crearSesion, reserva: TEXTO_RESERVA, baseEsperada: DIAGNOSTICO.precio, totalEsperado: precio.totalCentimos, serviciosEsperados: serviciosConImportes.map((sv) => ({ id: sv.id, total: sv.importes.totalCentimos, base: sv.importes.baseCentimos })) }}>
(function () {
  var estado = document.getElementById("contrata-estado");
  var form = document.getElementById("contrata-form");
  var lista = document.getElementById("contrata-semanas");
  var precioBox = document.getElementById("contrata-precio");
  var datos = null;
  var cancelado = new URLSearchParams(location.search).get("cancelado") === "1";
  if (cancelado && estado) {
    estado.textContent = "Has vuelto sin pagar. La reserva de la plaza caduca a los 30 minutos.";
  }
  function fallo() {
    if (form) form.hidden = true;
    if (estado) estado.innerHTML = "";
    if (estado) {
      estado.textContent = reserva + " ";
      var a = document.createElement("a");
      a.href = "/#contacto";
      a.textContent = "Ir al formulario";
      estado.appendChild(a);
    }
  }
  function textoSemana(iso) {
    var p = iso.split("-");
    var meses = ["enero","febrero","marzo","abril","mayo","junio","julio","agosto","septiembre","octubre","noviembre","diciembre"];
    return "Lunes " + Number(p[2]) + " de " + meses[Number(p[1]) - 1];
  }
  fetch(endpointDisp, { headers: { Accept: "application/json" } })
    .then(function (r) { return r.json(); })
    .then(function (disp) {
      if (!disp || disp.ok !== true || !disp.precio || disp.precio.base_centimos !== baseEsperada * 100 || disp.precio.total_centimos !== totalEsperado) {
        fallo();
        return;
      }
      // Los servicios y sus importes que anuncia el servidor tienen que ser los que muestra la página.
      var lista_s = disp.servicios || [];
      var cuadra = serviciosEsperados.every(function (e) {
        return lista_s.some(function (r) { return r.id === e.id && r.total_centimos === e.total && r.base_centimos === e.base; });
      });
      if (!cuadra) { fallo(); return; }
      datos = disp;
      if (!lista || !form) return;
      var hay = false;
      (disp.semanas || []).forEach(function (s, i) {
        var id = "semana-" + i;
        var label = document.createElement("label");
        label.className = "semana" + (s.libres < 1 ? " completa" : "");
        var input = document.createElement("input");
        input.type = "radio";
        input.name = "semana";
        input.value = s.lunes;
        input.id = id;
        input.required = true;
        if (s.libres < 1) input.disabled = true;
        else if (!hay) { input.checked = true; hay = true; }
        var span = document.createElement("span");
        var linea = textoSemana(s.lunes);
        if (s.libres < 1) linea += " · Completa";
        else linea += " · Disponible";
        span.textContent = linea;
        label.appendChild(input);
        label.appendChild(span);
        lista.appendChild(label);
      });
      if (!hay && disp.sin_plazas_texto && estado) estado.textContent = disp.sin_plazas_texto;
      else if (estado && !cancelado) estado.textContent = "";
      form.hidden = false;
      if (precioBox) precioBox.setAttribute("data-listo", "1");
    })
    .catch(fallo);

  // Con más de un servicio, el desglose y el botón siguen al servicio elegido.
  function eur(c) { return (c / 100).toLocaleString("es-ES", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + " €"; }
  if (form) form.addEventListener("change", function (ev) {
    var r = ev.target;
    if (!r || r.name !== "servicio") return;
    var total = Number(r.getAttribute("data-total")), base = Number(r.getAttribute("data-base"));
    var tt = document.querySelector(".contrata-total"), pb = document.getElementById("contrata-pagar");
    var ps = precioBox ? precioBox.querySelectorAll("strong") : [];
    if (ps.length > 1) { ps[0].textContent = eur(base); ps[1].textContent = eur(total - base); }
    if (tt) tt.textContent = "Total " + eur(total);
    var visibleTotal = document.getElementById("contrata-total-visible");
    if (visibleTotal) visibleTotal.textContent = eur(total);
    if (pb) pb.textContent = "Pagar " + eur(total);
  });

  var pasoSemana = document.getElementById("contrata-paso-semana");
  var pasoContacto = document.getElementById("contrata-paso-contacto");
  var continuar = document.getElementById("contrata-continuar");
  var volver = document.getElementById("contrata-volver");
  if (continuar) continuar.addEventListener("click", function () {
    var elegida = form && form.querySelector("input[name=semana]:checked");
    if (!elegida) {
      if (estado) estado.textContent = "Elige una semana disponible para continuar.";
      return;
    }
    if (estado) estado.textContent = "";
    if (pasoSemana) pasoSemana.hidden = true;
    if (pasoContacto) pasoContacto.hidden = false;
    var empresa = document.getElementById("contrata-empresa");
    if (empresa) empresa.focus();
  });
  if (volver) volver.addEventListener("click", function () {
    if (pasoContacto) pasoContacto.hidden = true;
    if (pasoSemana) pasoSemana.hidden = false;
    if (continuar) continuar.focus();
  });

  if (form) form.addEventListener("submit", function (ev) {
    ev.preventDefault();
    var marcada = form.querySelector("input[name=semana]:checked");
    var status = document.getElementById("contrata-estado");
    if (!datos || !datos.csrf || !marcada) {
      if (status) status.textContent = "Elige una semana con plazas.";
      return;
    }
    var elegido = form.querySelector("input[name=servicio]:checked");
    var fijo = document.getElementById("contrata-servicio");
    var producto = elegido ? elegido.value : (fijo ? fijo.getAttribute("data-servicio") : "");
    var body = {
      producto: producto,
      semana: marcada.value,
      csrf: datos.csrf,
      empresa: document.getElementById("contrata-empresa").value,
      email: document.getElementById("contrata-email").value,
      nif: document.getElementById("contrata-nif").value,
      condiciones: document.getElementById("contrata-condiciones").checked ? "si" : "",
      web: (form.querySelector("input[name=web]") || {}).value || ""
    };
    try {
      var o = JSON.parse(sessionStorage.getItem("sobtree_origen") || "null");
      if (o && o.utm) Object.keys(o.utm).forEach(function (k) { body[k] = o.utm[k]; });
    } catch (e) {}
    var boton = document.getElementById("contrata-pagar");
    if (boton) boton.disabled = true;
    fetch(endpointPago, { method: "POST", headers: { "Content-Type": "application/json", Accept: "application/json" }, body: JSON.stringify(body) })
      .then(function (r) { return r.json().then(function (j) { return { okhttp: r.ok, j: j }; }); })
      .then(function (res) {
        if (res.j && res.j.ok && res.j.url) { location.href = res.j.url; return; }
        if (status) status.textContent = (res.j && res.j.error) || "No hemos podido abrir el pago; inténtalo en un minuto o escríbenos.";
        if (boton) boton.disabled = false;
      })
      .catch(function () {
        if (status) status.textContent = "No hemos podido abrir el pago; inténtalo en un minuto o escríbenos.";
        if (boton) boton.disabled = false;
      });
  });
})();
</script>
<style>
  .contrata-page { padding-top: clamp(1.5rem, 3vw, 2.5rem); padding-bottom: clamp(2rem, 4vw, 3.5rem); }
  .contrata-wrap { max-width: 860px; }
  .contrata-heading { margin-bottom: 1.25rem; }
  .contrata-heading h1 { margin: 0.2rem 0 0.5rem; }
  .contrata-heading .section-sub { max-width: 58ch; margin-bottom: 0; }
  .contrata-resumen { display: grid; grid-template-columns: minmax(180px, 0.72fr) minmax(0, 1.5fr); gap: 1.25rem; align-items: center; margin: 1.25rem 0 1rem; padding: 1.15rem 1.25rem; border: 1px solid var(--line-strong, rgba(255,255,255,.24)); border-radius: 16px; background: var(--panel, #0C1F4F); color: var(--white, #fff); }
  .contrata-resumen p { margin: 0 0 0.55rem; }
  .contrata-resumen p:last-child { margin-bottom: 0; }
  .contrata-resumen .fine { color: var(--text-2, #D4DEF4); text-align: left; }
  .contrata-resumen-precio { padding-right: 1.25rem; border-right: 1px solid var(--line-strong, rgba(255,255,255,.24)); }
  .contrata-label { font-size: 0.85rem; color: var(--text-2, #D4DEF4); opacity: 1; }
  .contrata-resumen .contrata-total { font-size: clamp(1.8rem, 4vw, 2.25rem); line-height: 1.1; font-weight: 750; letter-spacing: -0.03em; }
  .contrata-resumen-detalle { min-width: 0; }
  .contrata-status:empty { display: none; }
  .contrata-status:not(:empty) { margin: 0.75rem 0; padding: 0.75rem 0.9rem; border-radius: 10px; background: var(--surface-alt, #f3f5f9); }
  #contrata-form { margin-top: 0.75rem; }
  #contrata-paso-semana[hidden], #contrata-paso-contacto[hidden] { display: none !important; }
  .contrata-ayuda-semana { text-align: left; margin: 0.65rem 0 0.9rem; }
  .contrata-paso-titulo { font-size: 1.25rem; margin: 0 0 1rem; }
  .contrata-acciones { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1rem; }
  .contrata-acciones .btn { white-space: normal; }
  #contrata-continuar { width: 100%; margin-top: 0.25rem; }
  @media (max-width: 640px) {
    .contrata-resumen { grid-template-columns: 1fr; gap: 0.85rem; padding: 1rem; }
    .contrata-resumen-precio { padding: 0 0 0.85rem; border-right: 0; border-bottom: 1px solid var(--line, #d9deea); }
  }
</style>
</Base>
) : (
<Base title="Sobtree" noindex={true}>
<main id="main" class="section"><div class="wrap"><p>Esta página no está publicada.</p></div></main>
</Base>
)}
