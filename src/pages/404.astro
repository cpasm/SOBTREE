---
import Base from "../layouts/Base.astro";
---
<Base title="Página no encontrada | Sobtree" noindex>
  <main id="main" class="section">
    <div class="wrap">
      <p class="eyebrow">Error 404</p>
      <h1 class="page-title">Esta página no existe</h1>
      <p class="section-sub">Puede que se haya movido. Vuelve al inicio o escríbenos si buscabas algo concreto.</p>
      <p style="margin-top:32px"><a class="btn btn-primary" href="/">Volver al inicio</a></p>
    </div>
  </main>
</Base>
