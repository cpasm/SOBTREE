---
import { render } from "astro:content";
import Post from "../../layouts/Post.astro";
import { getRadar } from "../../data/content";

export async function getStaticPaths() {
  const items = await getRadar();
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, date, puntos, imagen, imagenAlt } = entry.data;
---
<Post title={title} description={description} date={date} tags={["Radar"]} tema="radar" imagen={imagen} imagenAlt={imagenAlt} path={`/radar/${entry.id}/`} back={{ href: "/radar/", label: "Todas las entregas del Radar" }}>
  <ol class="radar-points" slot="intro">{puntos.map((p) => <li>{p}</li>)}</ol>
  <Content />
</Post>
