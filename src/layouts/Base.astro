---
import { SITE } from "../data/site";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { BUILD_VERSION } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
  jsonld?: string;
  noindex?: boolean;
  bare?: boolean; // sin cabecera ni pie (p. ej. páginas legales)
  image?: string; // absoluta; solo si la página tiene portada propia
  imageAlt?: string;
}
const { title = SITE.title, description = SITE.description, ogType = "website", jsonld, noindex = false, bare = false, image, imageAlt } = Astro.props;
// Absoluta, https (SITE.url), sin index.html y con la misma barra final que el sitemap.
const canonicalPath = Astro.url.pathname.replace(/index\.html$/, "") || "/";
const canonical = new URL(canonicalPath.endsWith("/") ? canonicalPath : `${canonicalPath}/`, SITE.url).href;
// Cambia en cada build para que los navegadores no usen CSS/JS antiguos de su caché (7 días).
const v = BUILD_VERSION;
---
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="theme-color" content="#050F2C">
{noindex ? <meta name="robots" content="noindex"> : <link rel="canonical" href={canonical}>}
<meta property="og:type" content={ogType}>
<meta property="og:site_name" content={SITE.name}>
<meta property="og:locale" content="es_ES">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
{image && <meta property="og:image" content={image}>}
{image && imageAlt && <meta property="og:image:alt" content={imageAlt}>}
<meta name="twitter:card" content={image ? "summary_large_image" : "summary"}>
{image && <meta name="twitter:image" content={image}>}
{image && imageAlt && <meta name="twitter:image:alt" content={imageAlt}>}
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/assets/favicon-32.png" type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="sitemap" href="/sitemap-index.xml">
<link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href={`/assets/styles.css?v=${v}`}>
<slot name="head" />
{jsonld && <script type="application/ld+json" set:html={jsonld} />}
</head>
<body>
{!bare && <a class="skip" href="#main">Saltar al contenido</a>}
{!bare && <Header />}
<slot />
{!bare && <Footer />}
{!bare && <script is:inline src={`/assets/nav.js?v=${v}`} defer></script>}
<script is:inline src={`/assets/origen.js?v=${v}`} defer></script>
</body>
</html>
